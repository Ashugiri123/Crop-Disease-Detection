# CropGuard AI Backend Environment Configuration
# Copy this file to .env to customize settings for your environment.

# Environment Mode: development | production
ENVIRONMENT=development

# Debug Mode (keep false in production)
DEBUG=false

# Swagger/OpenAPI documentation exposure (/docs and /redoc)
DOCS_ENABLED=true

# Allowed CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Rate limiting for expensive inference endpoints (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Maximum uploaded image file size in bytes (default: 10 MB)
MAX_IMAGE_SIZE_BYTES=10485760
