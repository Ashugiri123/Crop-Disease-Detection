# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environments and Secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.p12

# Virtual Environments
venv/
.venv/
env/
ENV/

# Frontend dependencies and production builds
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs and runtime files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Datasets and Archives (protect against accidental dataset commits)
dataset/
datasets/
data/
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# OS & Editor generated files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
.idea/
.vscode/
*.swp
*.swo
